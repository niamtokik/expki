<!-- Stats -->
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
<div class="rounded-2xl border border-border bg-white p-5">
  <div class="flex items-center justify-between">
    <p class="text-sm text-muted">Total revenue</p>
    <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-600">+12.5%</span>
  </div>
  <p class="mt-4 text-3xl font-semibold tracking-tight">$48,290</p>
  <p class="mt-2 text-xs text-muted">Compared with last month</p>
</div>

<div class="rounded-2xl border border-border bg-white p-5">
  <div class="flex items-center justify-between">
    <p class="text-sm text-muted">Active users</p>
    <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-600">+8.2%</span>
  </div>
  <p class="mt-4 text-3xl font-semibold tracking-tight">12,430</p>
  <p class="mt-2 text-xs text-muted">Compared with last month</p>
</div>

<div class="rounded-2xl border border-border bg-white p-5">
  <div class="flex items-center justify-between">
    <p class="text-sm text-muted">New customers</p>
    <span class="rounded-md bg-rose-50 px-2 py-1 text-xs font-medium text-rose-600">-2.4%</span>
  </div>
  <p class="mt-4 text-3xl font-semibold tracking-tight">1,284</p>
  <p class="mt-2 text-xs text-muted">Compared with last month</p>
</div>

<div class="rounded-2xl border border-border bg-white p-5">
  <div class="flex items-center justify-between">
    <p class="text-sm text-muted">Conversion rate</p>
    <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-600">+4.7%</span>
  </div>
  <p class="mt-4 text-3xl font-semibold tracking-tight">6.84%</p>
  <p class="mt-2 text-xs text-muted">Compared with last month</p>
</div>
</section>

<!-- Chart and activity -->
<section class="grid gap-6 xl:grid-cols-3">
<div class="rounded-2xl border border-border bg-white p-5 sm:p-6 xl:col-span-2">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="font-semibold">Revenue overview</h2>
      <p class="mt-1 text-sm text-muted">Monthly revenue performance</p>
    </div>

    <select class="rounded-lg border border-border bg-white px-3 py-2 text-sm text-muted outline-none focus:ring-2 focus:ring-zinc-200">
      <option>Last 7 months</option>
      <option>Last 30 days</option>
      <option>This year</option>
    </select>
  </div>

  <div class="mt-8">
    <div class="flex h-64 items-end gap-3 border-b border-l border-border px-3 sm:gap-6">
      <div class="h-[34%] flex-1 rounded-t-md bg-zinc-200"></div>
      <div class="h-[48%] flex-1 rounded-t-md bg-zinc-200"></div>
      <div class="h-[42%] flex-1 rounded-t-md bg-zinc-200"></div>
      <div class="h-[65%] flex-1 rounded-t-md bg-zinc-300"></div>
      <div class="h-[58%] flex-1 rounded-t-md bg-zinc-300"></div>
      <div class="h-[78%] flex-1 rounded-t-md bg-zinc-700"></div>
      <div class="h-[92%] flex-1 rounded-t-md bg-zinc-950"></div>
    </div>

    <div class="mt-3 flex justify-between pl-3 text-xs text-muted">
      <span>Apr</span>
      <span>May</span>
      <span>Jun</span>
      <span>Jul</span>
      <span>Aug</span>
      <span>Sep</span>
      <span>Oct</span>
    </div>
  </div>
</div>

<div class="rounded-2xl border border-border bg-white p-5 sm:p-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="font-semibold">Recent activity</h2>
      <p class="mt-1 text-sm text-muted">Latest updates</p>
    </div>
    <a href="#" class="text-sm font-medium text-zinc-900 hover:underline">View all</a>
  </div>

  <div class="mt-6 space-y-6">
    <div class="flex gap-3">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-xs font-semibold text-blue-700">JD</div>
      <div>
        <p class="text-sm"><span class="font-medium">Jordan Davis</span> joined the team</p>
        <p class="mt-1 text-xs text-muted">12 minutes ago</p>
      </div>
    </div>

    <div class="flex gap-3">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-semibold text-emerald-700">$</div>
      <div>
        <p class="text-sm">Payment of <span class="font-medium">$2,400</span> received</p>
        <p class="mt-1 text-xs text-muted">2 hours ago</p>
      </div>
    </div>

    <div class="flex gap-3">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-semibold text-purple-700">M</div>
      <div>
        <p class="text-sm"><span class="font-medium">Marketing report</span> was generated</p>
        <p class="mt-1 text-xs text-muted">Yesterday</p>
      </div>
    </div>

    <div class="flex gap-3">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-100 text-xs font-semibold text-orange-700">!</div>
      <div>
        <p class="text-sm">Storage usage reached <span class="font-medium">80%</span></p>
        <p class="mt-1 text-xs text-muted">Yesterday</p>
      </div>
    </div>
  </div>
</div>
</section>

<!-- Table -->
<section class="overflow-hidden rounded-2xl border border-border bg-white">
<div class="flex items-center justify-between border-b border-border p-5 sm:p-6">
  <div>
    <h2 class="font-semibold">Recent transactions</h2>
    <p class="mt-1 text-sm text-muted">Your latest account activity</p>
  </div>
  <button class="rounded-lg border border-border px-3 py-2 text-sm font-medium hover:bg-zinc-50">
    Export
  </button>
</div>

<div class="overflow-x-auto">
  <table class="w-full min-w-[640px] text-left text-sm">
    <thead class="bg-zinc-50 text-xs uppercase tracking-wide text-muted">
      <tr>
        <th class="px-6 py-3 font-medium">Customer</th>
        <th class="px-6 py-3 font-medium">Date</th>
        <th class="px-6 py-3 font-medium">Status</th>
        <th class="px-6 py-3 text-right font-medium">Amount</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      <tr>
        <td class="px-6 py-4 font-medium">Olivia Martin</td>
        <td class="px-6 py-4 text-muted">Sep 30, 2026</td>
        <td class="px-6 py-4">
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">Completed</span>
        </td>
        <td class="px-6 py-4 text-right font-medium">$1,250.00</td>
      </tr>
      <tr>
        <td class="px-6 py-4 font-medium">Jackson Lee</td>
        <td class="px-6 py-4 text-muted">Sep 29, 2026</td>
        <td class="px-6 py-4">
          <span class="rounded-full bg-yellow-50 px-2.5 py-1 text-xs font-medium text-yellow-700">Pending</span>
        </td>
        <td class="px-6 py-4 text-right font-medium">$840.00</td>
      </tr>
      <tr>
        <td class="px-6 py-4 font-medium">Sophia Brown</td>
        <td class="px-6 py-4 text-muted">Sep 28, 2026</td>
        <td class="px-6 py-4">
          <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">Completed</span>
        </td>
        <td class="px-6 py-4 text-right font-medium">$2,100.00</td>
      </tr>
    </tbody>
  </table>
</div>
</section>
